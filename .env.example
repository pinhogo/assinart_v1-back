APP_NAME=Assinart
# Use APP_ENV=local e APP_DEBUG=true apenas para desenvolvimento local
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

CORS_ALLOWED_ORIGINS=https://assin.art,https://www.assin.art

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco de dados ---
# SQLite e EXCLUSIVO para desenvolvimento local e testes (phpunit usa :memory:).
# Producao (Azure) deve usar DB_CONNECTION=pgsql ou mysql.
DB_CONNECTION=sqlite
# Producao: Azure Database for PostgreSQL (pgsql) ou MySQL (mysql)
# DB_CONNECTION=pgsql
# DB_HOST=<servidor>.postgres.database.azure.com
# DB_PORT=5432
# DB_DATABASE=assinart
# DB_USERNAME=
# DB_PASSWORD=
# TLS PostgreSQL: use require (ou verify-full com DB_SSLROOTCERT)
DB_SSLMODE=require
DB_SSLROOTCERT=
# TLS MySQL: caminho do certificado CA e verificacao do servidor
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# --- Storage de midia (compativel com deploy Azure) ---
MEDIA_DISK=public
AZURE_STORAGE_NAME=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=media
AZURE_STORAGE_URL=
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONNECTION_STRING=

# 'database' pode ser usado apos rodar a migration da tabela jobs
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@assin.art"
MAIL_FROM_NAME="${APP_NAME}"
