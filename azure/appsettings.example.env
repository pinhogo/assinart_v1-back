# App Settings de Produção — Azure App Service (Linux / PHP 8.3)
# Preencha valores sensíveis no Azure Portal ou via `az webapp config appsettings set`.

APP_NAME=Assinart
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GERAR_COM_OPENSSL_RAND_BASE64_32
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_URL=https://assinart-api.azurewebsites.net
FRONTEND_URL=https://assin.art

FILESYSTEM_DISK=public
MEDIA_DISK=public

DB_CONNECTION=pgsql
DB_HOST=assinart-api-pg.postgres.database.azure.com
DB_PORT=5432
DB_DATABASE=assinart
DB_USERNAME=assinart_admin
DB_PASSWORD=DEFINIR_NO_AZURE_APP_SETTINGS
DB_SSLMODE=require

# Fallback MVP opcional caso retorne para SQLite (/home/data/database.sqlite):
# DB_CONNECTION=sqlite
# DB_DATABASE=/home/data/database.sqlite
# DB_SQLITE_BUSY_TIMEOUT=5000
# DB_SQLITE_JOURNAL_MODE=WAL

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=DEFINIR_NO_AZURE_APP_SETTINGS
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contato@assin.art"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="sac@assin.art"
MAIL_REPLY_TO_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=https://assin.art,https://www.assin.art
# E-mails autorizados para o painel administrativo /admin (separados por virgula)
ADMIN_EMAILS=

WEBSITES_ENABLE_APP_SERVICE_STORAGE=true
WEBSITES_CONTAINER_START_TIME_LIMIT=230
